# Copy this file to ".env" and fill in the real values.
# The ".env" must never be committed (it is already in .gitignore).

# Anthropic (Claude) API key, used to generate the pedigree
# from the anamnesis. Get it at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Secret key used to sign the JWT authentication tokens.
# Generate a strong random key (e.g.: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=

# Optional. Database connection string.
# If not set, the system uses SQLite locally (sqlite:///./heredograma.db) -
# ideal for development, with nothing extra to install.
# In production, point to a Postgres:
#   DATABASE_URL=postgresql://user:password@host:port/database_name
# DATABASE_URL=sqlite:///./heredograma.db

# Optional. List of origins (domains) allowed to call the API,
# comma-separated. If not set, any origin ("*") is allowed,
# which is acceptable in local development but must NOT be used in
# production - set it to the real frontend domain(s), e.g.:
#   ALLOWED_ORIGINS=https://app.example.com,https://example.com
# ALLOWED_ORIGINS=*
