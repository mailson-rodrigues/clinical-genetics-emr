# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Chave de API da Anthropic (Claude), usada para gerar o heredograma
# a partir da anamnese. Obtenha em https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Chave secreta usada para assinar os tokens JWT de autenticação.
# Gere uma chave aleatória forte (ex: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=

# Opcional. String de conexão do banco de dados.
# Se não for definida, o sistema usa SQLite localmente (sqlite:///./heredograma.db) -
# ideal para desenvolvimento, sem precisar instalar nada extra.
# Em produção, aponte para um Postgres:
#   DATABASE_URL=postgresql://usuario:senha@host:porta/nome_banco
# DATABASE_URL=sqlite:///./heredograma.db

# Opcional. Lista de origens (domínios) autorizadas a chamar a API,
# separadas por vírgula. Se não for definida, libera qualquer origem ("*"),
# o que é aceitável em desenvolvimento local mas NÃO deve ser usado em
# produção - defina com o(s) domínio(s) real(is) do frontend, ex:
#   ALLOWED_ORIGINS=https://app.exemplo.com,https://exemplo.com
# ALLOWED_ORIGINS=*
